      "slots": [
        { "name": "tag", "type": "text", "maxChars": 24 },
        { "name": "text", "type": "text", "maxChars": 30 }
      ],
      "duration": { "min": 3, "max": 4.5 },
      "preview": { "mp4": "preview/si-desert-authority.t2.label.mp4", "poster": "preview/si-desert-authority.t2.label.png" }
    },
    {
      "id": "si-desert-authority.t2.list",
      "tier": "tier2",
      "purpose": "list",
