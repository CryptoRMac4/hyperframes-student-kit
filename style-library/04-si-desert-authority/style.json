{
  "$schema": "../registry.schema.json",
  "id": "si-desert-authority",
  "name": "SI Desert Authority",
  "number": "04",
  "status": "draft",
  "inspiration": "Sonoran Intelligence brand system (Desert Authority) plus the live sonoranintel.com main.css: saguaro/sand sections, Barlow Condensed display, tracked eyebrows with a short leading rule, terracotta as a rare accent. Real logo mark from sonoranintel.com/images/sic-logo.png.",
  "summary": "Grounded, warm, quietly confident cards for Sonoran Intelligence videos aimed at local business owners: AI marketing explainers, audit walkthroughs, client results. Flat earth-tone surfaces, big condensed type, one terracotta marker per card, a hairline horizon with sun arcs as the recurring motif.",
  "palette": {
    "saguaro": "#2D3A2E",
    "terracotta": "#C8682E",
    "terracottaDeep": "#8F4A1E",
    "sand": "#E8D5B7",
    "bone": "#F5EDE0",
    "mesquite": "#3D2E1F",
    "adobe": "#8B6F47",
    "bg": "#2D3A2E",
    "fg": "#F5EDE0",
    "accent": "#C8682E",
    "notes": "Exactly six brand colors plus terracotta-deep. Never pure white or black. Terracotta surfaces carry bone text only (Ryan is red/green colorblind). Meaning is never encoded by hue alone. Mirrored in tokens.css."
  },
  "fonts": {
    "display": "Barlow Condensed",
    "body": "Barlow",
    "mono": "Barlow",
    "notes": "Matches live sonoranintel.com (Ryan ruling 2026-09-13). Vendored OFL woff2 in fonts/: Barlow Condensed 600/700, Barlow 400/500/600. Tabular numerals on every stat."
  },
  "motion": "Steady and confident. Firm ease-outs (power3.out entrances, power2.inOut rules and wipes, power2.in exits), count-ups on numbers, hairline strokes that draw in, a slow 6-8px drift during holds. No elastic, glitch, neon, or HUD.",
  "transitions": "Clean slides, mask reveals, clip-path wipes, and a saguaro panel wipe on section markers. Exits reverse the entrance direction in 0.45s.",
  "cards": [
    {
      "id": "si-desert-authority.t1.thesis",
      "tier": "tier1",
      "purpose": "thesis",
      "file": "cards/tier1/t1-thesis.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 32 },
        { "name": "headline", "type": "richtext", "maxChars": 60, "note": "Wrap the 1-3 word key phrase in <em> for the terracotta underline. Two balanced lines." },
        { "name": "sub", "type": "text", "maxChars": 90 }
      ],
      "duration": { "min": 4.5, "max": 6 },
      "preview": { "mp4": "preview/si-desert-authority.t1.thesis.mp4", "poster": "preview/si-desert-authority.t1.thesis.png" }
    },
    {
      "id": "si-desert-authority.t1.stat",
      "tier": "tier1",
      "purpose": "stat",
      "file": "cards/tier1/t1-stat.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 32 },
        { "name": "stat", "type": "text", "maxChars": 7, "note": "prefix + number + suffix, e.g. 74%, $8,000, 3.4x. Counts up from 0." },
        { "name": "label", "type": "text", "maxChars": 80 },
        { "name": "source", "type": "text", "maxChars": 60, "note": "Default text is \"Source: add source\". Fill with a real, verifiable source or leave empty. Never invent one." }
      ],
      "duration": { "min": 4.5, "max": 6 },
      "preview": { "mp4": "preview/si-desert-authority.t1.stat.mp4", "poster": "preview/si-desert-authority.t1.stat.png" }
    },
    {
      "id": "si-desert-authority.t1.section",
      "tier": "tier1",
      "purpose": "section",
      "file": "cards/tier1/t1-section.html",
      "slots": [
        { "name": "number", "type": "text", "maxChars": 2 },
        { "name": "kicker", "type": "text", "maxChars": 24 },
        { "name": "title", "type": "text", "maxChars": 36 }
      ],
      "duration": { "min": 3.5, "max": 5 },
      "preview": { "mp4": "preview/si-desert-authority.t1.section.mp4", "poster": "preview/si-desert-authority.t1.section.png" }
    },
    {
      "id": "si-desert-authority.t1.quote",
      "tier": "tier1",
      "purpose": "quote",
      "file": "cards/tier1/t1-quote.html",
      "slots": [
        { "name": "source", "type": "text", "maxChars": 24, "note": "Where the real review came from, e.g. Google review. Default placeholder: Review source." },
        { "name": "quote", "type": "text", "maxChars": 120, "note": "Real client words only, no quotation marks; the card draws one." },
        { "name": "name", "type": "text", "maxChars": 28, "note": "Client Name, Business" },
        { "name": "business", "type": "text", "maxChars": 44, "note": "City, AZ" }
      ],
      "duration": { "min": 5, "max": 7 },
      "preview": { "mp4": "preview/si-desert-authority.t1.quote.mp4", "poster": "preview/si-desert-authority.t1.quote.png" }
    },
    {
      "id": "si-desert-authority.t1.overview",
      "tier": "tier1",
      "purpose": "overview",
      "file": "cards/tier1/t1-overview.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 32 },
        { "name": "headline", "type": "text", "maxChars": 48 },
        { "name": "steps", "type": "list", "minItems": 3, "maxItems": 4, "maxChars": 60, "note": "Each <li> holds <span class=\"t\">title, max 16 chars</span><span class=\"d\">detail, max 44 chars, two even lines</span>. Numbers are automatic." }
      ],
      "duration": { "min": 5, "max": 7 },
      "preview": { "mp4": "preview/si-desert-authority.t1.overview.mp4", "poster": "preview/si-desert-authority.t1.overview.png" }
    },
    {
