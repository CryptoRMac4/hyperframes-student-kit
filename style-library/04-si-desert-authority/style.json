      "file": "cards/tier2/t2-lower-third.html",
      "slots": [
        { "name": "name", "type": "text", "maxChars": 26 },
        { "name": "title", "type": "text", "maxChars": 36 }
      ],
      "duration": { "min": 3.5, "max": 5 },
      "preview": { "mp4": "preview/si-desert-authority.t2.lower-third.mp4", "poster": "preview/si-desert-authority.t2.lower-third.png" }
    },
    {
      "id": "si-desert-authority.t2.label",
