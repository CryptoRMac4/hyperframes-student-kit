      "slots": [
        { "name": "term", "type": "text", "maxChars": 26 },
        { "name": "part", "type": "text", "maxChars": 14 },
        { "name": "definition", "type": "text", "maxChars": 100 }
      ],
      "duration": { "min": 4, "max": 6 },
      "preview": { "mp4": "preview/si-desert-authority.t2.definition.mp4", "poster": "preview/si-desert-authority.t2.definition.png" }
    },
    {
      "id": "si-desert-authority.custom.before-after",
      "tier": "custom",
      "purpose": "before-after",
      "file": "cards/custom/c-before-after.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 32 },
        { "name": "metric", "type": "text", "maxChars": 34 },
        { "name": "beforeLabel", "type": "text", "maxChars": 14 },
        { "name": "beforeValue", "type": "text", "maxChars": 5, "note": "number with optional prefix/suffix; counts up" },
        { "name": "afterLabel", "type": "text", "maxChars": 16 },
        { "name": "afterValue", "type": "text", "maxChars": 5, "note": "number with optional prefix/suffix; counts up" },
        { "name": "note", "type": "text", "maxChars": 80 }
      ],
      "duration": { "min": 5.5, "max": 7.5 },
      "preview": { "mp4": "preview/si-desert-authority.custom.before-after.mp4", "poster": "preview/si-desert-authority.custom.before-after.png" }
    },
    {
      "id": "si-desert-authority.custom.score-gauge",
      "tier": "custom",
      "purpose": "score-gauge",
      "file": "cards/custom/c-score-gauge.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 28 },
        { "name": "business", "type": "text", "maxChars": 28 },
        { "name": "score", "type": "text", "maxChars": 3, "note": "integer 0-100" },
        { "name": "grade", "type": "text", "maxChars": 14, "note": "words, e.g. Needs work / Solid / Strong" },
        { "name": "note", "type": "text", "maxChars": 70 }
      ],
      "duration": { "min": 5, "max": 7 },
      "preview": { "mp4": "preview/si-desert-authority.custom.score-gauge.mp4", "poster": "preview/si-desert-authority.custom.score-gauge.png" }
    },
    {
      "id": "si-desert-authority.custom.ranking-climb",
      "tier": "custom",
      "purpose": "ranking-climb",
      "file": "cards/custom/c-ranking-climb.html",
      "slots": [
        { "name": "kicker", "type": "text", "maxChars": 28 },
        { "name": "query", "type": "text", "maxChars": 24, "note": "include the curly quotes" },
        { "name": "from", "type": "text", "maxChars": 1, "note": "starting rank 2-5" },
        { "name": "to", "type": "text", "maxChars": 1, "note": "target rank 1-4, less than from" },
        { "name": "note", "type": "text", "maxChars": 64 },
        { "name": "business", "type": "text", "maxChars": 24 },
        { "name": "competitors", "type": "list", "minItems": 4, "maxItems": 4, "maxChars": 24 }
      ],
      "duration": { "min": 5.5, "max": 7 },
      "preview": { "mp4": "preview/si-desert-authority.custom.ranking-climb.mp4", "poster": "preview/si-desert-authority.custom.ranking-climb.png" }
    },
    {
      "id": "si-desert-authority.custom.end-card",
      "tier": "custom",
